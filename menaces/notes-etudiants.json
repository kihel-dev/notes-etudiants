            "data": {
              "name": "API web",
              "description": "Application Flask : identifie l'utilisateur, vérifie ses droits, lit et écrit les notes.",
              "type": "tm.Process",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "status": "Open",
                  "severity": "High",
                  "title": "Connexion avec le mot de passe volé d'un enseignant",
                  "type": "Spoofing",
                  "description": "Un étudiant obtient le mot de passe d'un enseignant et se connecte à sa place pour modifier des notes.",
                  "mitigation": "Authentification forte (mot de passe + code), blocage après plusieurs échecs.",
                  "modelType": "STRIDE",
                  "id": "31e8d45d-f04f-4c5f-9f89-9196ad979aa8",
                  "number": 4,
                  "score": ""
                },
                {
                  "status": "Open",
                  "severity": "Critical",
                  "title": "Un étudiant appelle directement la modification d'une note",
                  "type": "Elevation of privilege",
                  "description": "L'application cache le bouton « Modifier » aux étudiants, mais l'API ne vérifie pas le rôle : un étudiant envoie la demande lui-même.",
                  "mitigation": "Vérifier sur chaque route de l'API que l'utilisateur a le bon rôle (autorisation).",
                  "modelType": "STRIDE",
                  "id": "ee5352ae-6ed4-4134-8359-68717fe5a35d",
                  "number": 5,
                  "score": ""
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "title": "Des milliers de requêtes le jour des résultats",
                  "type": "Denial of service",
                  "description": "Un attaquant envoie un grand nombre de requêtes et bloque l'API au moment de la publication des résultats.",
                  "mitigation": "Limiter le nombre de requêtes par utilisateur et par minute.",
                  "modelType": "STRIDE",
                  "id": "a83ac15c-0f85-462c-9957-aed95048aef8",
                  "number": 6,
                  "score": ""
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "title": "Un enseignant nie avoir modifié une note",
                  "type": "Repudiation",
                  "description": "Une note est modifiée et personne ne peut prouver qui l'a fait, car l'API n'enregistre aucune trace des modifications.",
                  "mitigation": "Journaliser chaque modification dans l'API : qui, quand, quelle note, ancienne et nouvelle valeur ; journal protégé contre la modification.",
                  "modelType": "STRIDE",
                  "id": "056d35e8-113e-4625-899c-cd0939a76af0",
                  "number": 7,
                  "score": ""
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "title": "Messages d'erreur trop détaillés",
                  "type": "Information disclosure",
                  "description": "En cas d'erreur, l'API renvoie le message technique (requête SQL, chemin de la base).",
                  "mitigation": "Renvoyer un message générique ; garder le détail dans les journaux du serveur.",
                  "modelType": "STRIDE",
                  "id": "40651c36-0a1c-4b9b-a75d-bfb5f48cc9f7",
                  "number": 8,
                  "score": ""
                }
